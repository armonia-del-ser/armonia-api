# Database Configuration
# Local SQLite fallback:
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Remote Turso production:
# DATABASE_URL=libsql://armonia-db-yourorg.turso.io
# DATABASE_AUTH_TOKEN=your_turso_token_here

# App settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://armonia-dashboard.pages.dev","https://armonia-landing.pages.dev"]

# Admin Security (for armonia-dashboard)
ADMIN_API_KEY=dev-secret-key-change-in-production

# Jazmin Business Settings
THERAPIST_NAME="Jazmín"
BUSINESS_NAME="Armonía del Ser"
WHATSAPP_PHONE="521XXXXXXXXXX"
SPEI_CLABE="012345678901234567"
SPEI_BANK="BBVA"
SPEI_BENEFICIARY="Jazmín"

# Google Calendar Integration (Optional in local dev)
GCAL_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=
